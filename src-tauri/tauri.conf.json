{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bucketeer",
  "version": "0.1.0-rc.3",
  "identifier": "dev.bucketeer.app",
  "build": {
    "frontendDist": "../out/tauri",
    "devUrl": "http://localhost:5175",
    "beforeDevCommand": "npm run tauri:web",
    "beforeBuildCommand": "npm run tauri:web:build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Bucketeer",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 560,
        "backgroundColor": "#14161d",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https: http:; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis",
      "appimage",
      "deb",
      "rpm"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Local-first browser for S3-compatible object storage",
    "copyright": "Christophe Roos — MIT"
  }
}
