{
  "name": "bucketeer",
  "version": "0.1.0",
  "description": "Local-first desktop browser for S3-compatible storage (OVHcloud, AWS S3, Scaleway, Wasabi, R2, MinIO): dual-pane transfers, public and signed links. No account, no cloud.",
  "author": "Christophe Roos",
  "license": "MIT",
  "private": true,
  "type": "module",
  "homepage": "https://github.com/croos555/bucketeer",
  "repository": {
    "type": "git",
    "url": "https://github.com/croos555/bucketeer.git"
  },
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist": "tauri build",
    "tauri": "tauri",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-opener": "^2.7.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "zustand": "^5.0.15"
  },
  "bugs": {
    "url": "https://github.com/croos555/bucketeer/issues"
  },
  "keywords": [
    "s3",
    "s3-client",
    "object-storage",
    "ovhcloud",
    "minio",
    "cloudflare-r2",
    "tauri",
    "file-manager",
    "cyberduck-alternative"
  ]
}
